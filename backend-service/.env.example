# Configuracion de Notion
NOTION_API_KEY=ntn_your_notion_api_key_here
NOTION_NOTES_DATABASE_ID=your_notes_database_id_here
NOTION_CLASSES_DATABASE_ID=your_classes_database_id_here

# Configuracion de Supabase (Recordatorios)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Configuracion de Google Gemini (Google AI Studio - Free Tier)
GEMINI_API_KEY=your_gemini_api_key_here

# Configuracion de WhatsApp
# Numero de telefono de Gabriel con codigo de pais (ej. 584121234567)
TARGET_PHONE_NUMBER=584121234567

# Intervalo de verificacion de recordatorios (cron: cada minuto)
REMINDER_CRON_SCHEDULE=* * * * *

# Puerto de servicio
PORT=3000
